#!/bin/bash
set -euo pipefail

APP_ROOT="${CODEX_APP_ROOT:-/opt/codex-app-linux}"
REAL_CODEX="$APP_ROOT/runtime/codex-cli/codex"
export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"

if [ ! -x "$REAL_CODEX" ]; then
  echo "codex: bundled Codex CLI not found: $REAL_CODEX" >&2
  exit 127
fi

exec "$REAL_CODEX" "$@"
